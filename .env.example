# Public site URL (used for metadata, sitemap, canonical URLs, structured data)
NEXT_PUBLIC_SITE_URL=https://www.highlooksteel.com

# Business contact (used across the site for tel:/wa.me links)
NEXT_PUBLIC_PHONE_DISPLAY="98452 71535"
NEXT_PUBLIC_PHONE_E164=+919845271535
NEXT_PUBLIC_WHATSAPP_NUMBER=919845271535

# Analytics — leave blank to disable. Provider is read at build time.
# Supported values: "ga4" | "plausible" | "" (disabled)
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Service request form submission endpoint.
# Until a backend exists, leave unset — the form will show a "coming soon"
# state instead of pretending to submit. See README "Connecting the request form".
NEXT_PUBLIC_FORM_ENDPOINT=
